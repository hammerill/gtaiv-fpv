# Writes OUT (build_info.h) with the mod's version and commit for libfpv's
# F8 > About tab (libfpv docs/INTEGRATION.md "The About tab"). Runs on every
# build, not at configure time, so a new commit shows without reconfiguring;
# the header is only rewritten when it changes.
#   -DSRC=<repo> -DOUT=<header>; GTAIV_FPV_VERSION in the environment names
#   the version (CI: build-<run number>), else "dev".
set(version "$ENV{GTAIV_FPV_VERSION}")
if(version STREQUAL "")
  set(version "dev")
endif()
execute_process(COMMAND git -C "${SRC}" rev-parse HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE git_failed ERROR_QUIET)
if(git_failed OR commit STREQUAL "")
  set(build "${version} (unknown commit), GTA IV 1.2.0.59")
else()
  execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes ERROR_QUIET)
  if(changes STREQUAL "")
    set(build "${version} (${commit}), GTA IV 1.2.0.59")
  else()
    set(build "${version} (${commit}, dirty), GTA IV 1.2.0.59")
  endif()
endif()
set(content "// Generated by cmake/build_info.cmake on every build.\n#pragma once\n#define GTAIV_FPV_BUILD \"${build}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
